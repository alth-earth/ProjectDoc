{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arctic-route/risk-explanation.v1.schema.json",
  "title": "Risk Explanation Sidecar v1 proposal",
  "description": "Optional presentation/research metadata bound to an immutable committed RiskWindow and its RiskFrames. Structural validation is necessary but not sufficient; identity, grid, risk-value, coverage, and contribution-sum invariants require semantic validation against the referenced artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_status",
    "identity",
    "producer",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "const": "risk-explanation.v1"
    },
    "publication_status": {
      "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]
    },
    "identity": {
      "$ref": "#/$defs/windowIdentity"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/frameExplanation"
      }
    }
  },
  "$defs": {
    "contractId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "windowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_window_id",
        "run_id",
        "scenario_id",
        "corridor_id",
        "vessel_profile_id",
        "config_digest",
        "model_config_digest",
        "generation_id",
        "as_of_time"
      ],
      "properties": {
        "risk_window_id": {
          "type": "string",
          "pattern": "^risk-window-sha256-[0-9a-f]{64}$",
          "description": "Exact CommittedRiskWindow.commit_id."
        },
        "run_id": {
          "type": "string",
          "pattern": "^run-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "scenario_id": {
          "$ref": "#/$defs/contractId"
        },
        "corridor_id": {
          "$ref": "#/$defs/contractId"
        },
        "vessel_profile_id": {
          "$ref": "#/$defs/contractId"
        },
        "config_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model_config_digest": {
          "$ref": "#/$defs/sha256"
        },
        "generation_id": {
          "type": "integer",
          "minimum": 0
        },
        "as_of_time": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "generated_at",
        "formula_version",
        "formula_component_ids",
        "decomposition_method",
        "calibration_status",
        "source_risk_provenance",
        "sidecar_maturity"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "$ref": "#/$defs/utcDateTime"
        },
        "formula_version": {
          "type": "string",
          "minLength": 1
        },
        "formula_component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "decomposition_method": {
          "enum": [
            "weighted_additive_decomposition_v1",
            "source_provided_attribution_v1"
          ]
        },
        "calibration_status": {
          "enum": [
            "demo_unvalidated",
            "experimental_unverified",
            "calibrated"
          ]
        },
        "source_risk_provenance": {
          "enum": ["formal", "synthetic", "legacy_unverified"]
        },
        "sidecar_maturity": {
          "enum": ["design_example", "research_unvalidated", "validated"]
        }
      }
    },
    "frameExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_frame_id",
        "frame_time",
        "grid",
        "coverage",
        "cells"
      ],
      "properties": {
        "risk_frame_id": {
          "type": "string",
          "pattern": "^risk-sha256-[0-9a-f]{64}$"
        },
        "frame_time": {
          "$ref": "#/$defs/utcDateTime",
          "description": "Exact RiskFrame.valid_time."
        },
        "grid": {
          "$ref": "#/$defs/gridIdentity"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cellExplanation"
          }
        }
      }
    },
    "gridIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_id", "crs", "rows", "columns"],
      "properties": {
        "grid_id": {
          "type": "string",
          "minLength": 1
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_cell_count",
        "published_cell_count",
        "complete_cell_count",
        "partial_cell_count",
        "unavailable_cell_count",
        "omitted_cell_count"
      ],
      "properties": {
        "expected_cell_count": {
          "type": "integer",
          "minimum": 1
        },
        "published_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "complete_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "partial_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_cell_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cellExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "explanation_status",
        "risk",
        "contributors",
        "reason",
        "uncertainty"
      ],
      "properties": {
        "cell": {
          "$ref": "#/$defs/cellIdentity"
        },
        "explanation_status": {
          "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]
        },
        "risk": {
          "$ref": "#/$defs/riskSnapshot"
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contributor"
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "explanation_status": {
                "const": "COMPLETE"
              }
            },
            "required": ["explanation_status"]
          },
          "then": {
            "properties": {
              "contributors": {
                "minItems": 1
              },
              "reason": {
                "properties": {
                  "code": {
                    "enum": ["DOMINANT_CONTRIBUTOR", "MULTIPLE_CONTRIBUTORS"]
                  }
                }
              },
              "uncertainty": {
                "properties": {
                  "status": {
                    "const": "NONE"
                  },
                  "missing_data": {
                    "maxItems": 0
                  },
                  "explanation_gaps": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "explanation_status": {
                "const": "PARTIAL"
              }
            },
            "required": ["explanation_status"]
          },
          "then": {
            "properties": {
              "contributors": {
                "minItems": 1
              },
              "reason": {
                "properties": {
                  "code": {
                    "enum": ["PARTIAL_EXPLANATION", "MISSING_DATA"]
                  }
                }
              },
              "uncertainty": {
                "not": {
                  "properties": {
                    "status": {
                      "const": "NONE"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "explanation_status": {
                "const": "UNAVAILABLE"
              }
            },
            "required": ["explanation_status"]
          },
          "then": {
            "properties": {
              "contributors": {
                "maxItems": 0
              },
              "reason": {
                "properties": {
                  "code": {
                    "enum": ["EXPLANATION_UNAVAILABLE", "MISSING_DATA"]
                  },
                  "main_contributor_ids": {
                    "maxItems": 0
                  }
                }
              },
              "uncertainty": {
                "not": {
                  "properties": {
                    "status": {
                      "const": "NONE"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      ]
    },
    "cellIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_index", "column_index", "latitude", "longitude"],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0
        },
        "column_index": {
          "type": "integer",
          "minimum": 0
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "riskSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "confidence"],
      "properties": {
        "score": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "score": {
                "type": "null"
              }
            },
            "required": ["score"]
          },
          "then": {
            "properties": {
              "level": {
                "const": 5
              },
              "confidence": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributor_id",
        "display_name",
        "contribution",
        "component_ids"
      ],
      "properties": {
        "contributor_id": {
          "$ref": "#/$defs/componentId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "contribution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Verified additive contribution to risk.score, not a raw environmental measurement."
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        },
        "dominant_component_id": {
          "$ref": "#/$defs/componentId"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "text", "locale", "main_contributor_ids"],
      "properties": {
        "code": {
          "enum": [
            "DOMINANT_CONTRIBUTOR",
            "MULTIPLE_CONTRIBUTORS",
            "PARTIAL_EXPLANATION",
            "EXPLANATION_UNAVAILABLE",
            "MISSING_DATA"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "main_contributor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing_data", "explanation_gaps"],
      "properties": {
        "status": {
          "enum": ["NONE", "MISSING_DATA", "EXPLANATION_GAP", "UNKNOWN"]
        },
        "missing_data": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/missingDatum"
          }
        },
        "explanation_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentId"
          }
        }
      }
    },
    "missingDatum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_type", "cause"],
      "properties": {
        "data_type": {
          "$ref": "#/$defs/componentId"
        },
        "cause": {
          "enum": [
            "MISSING_INPUT",
            "NON_FINITE_INPUT",
            "UNAVAILABLE_PROVENANCE",
            "UNSUPPORTED_DECOMPOSITION",
            "NOT_PUBLISHED"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
